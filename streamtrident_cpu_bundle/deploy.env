# StreamTrident CPU 部署包默认配置。
# 运行 scripts/start-*.sh 前，先按真实环境修改本文件。

# 采集端主机 IP。
# 默认是单机部署：采集端、分析端、UI 都在同一台机器上，所以填 127.0.0.1。
# 分机部署时，在分析端和 UI 端把这里改成采集端真实 IP。
CAPTURE_HOST=172.16.89.46

# Suricata 抓包网卡名。必须改成采集端机器上的真实网卡，例如 eth0、ens35、enp3s0。
SURICATA_IFACE=ens37

# 采集端暴露给分析端的端口。
# Redis 用于传输 CIC flow 队列；Suricata agent 用于下发/刷新采集规则。
REDIS_HOST_PORT=16379
SURICATA_AGENT_HOST_PORT=19100

# 分析端 Trident API 端口，供前端 UI 访问。
TRIDENT_API_HOST_PORT=8090

# 前端 UI 访问端口。
UI_HOST_PORT=8088

# Worker 运行模式。首次建模先用 cold_start；冷启动完成后改成 inference。
TRIDENT_WORKER_MODE=cold_start

# 以下通常由 CAPTURE_HOST 和端口自动派生；只有特殊网络映射时才需要手动改。
CAPTURE_REDIS_HOST=${CAPTURE_HOST}
CAPTURE_REDIS_PORT=${REDIS_HOST_PORT}
TRIDENT_SURICATA_AGENT_URLS=http://${CAPTURE_HOST}:${SURICATA_AGENT_HOST_PORT}

# 分析端主机 IP。
# 默认是单机部署：采集端、分析端、UI 都在同一台机器上，所以填 127.0.0.1。
# UI 和分析端分机部署时，在 UI 端把这里改成分析端真实 IP。
ANALYSIS_HOST=172.16.89.45

# 前端反向代理后端地址。通常会随 ANALYSIS_HOST 和 TRIDENT_API_HOST_PORT 自动派生。
API_AUTH_UPSTREAM=http://${ANALYSIS_HOST}:${TRIDENT_API_HOST_PORT}
API_TRIDENT_UPSTREAM=http://${ANALYSIS_HOST}:${TRIDENT_API_HOST_PORT}
